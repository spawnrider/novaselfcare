{
  "name": "selfcare-lab-angular-msw-orval",
  "version": "0.1.0",
  "private": true,
  "description": "Nova Selfcare – démo contract-first Angular 21 SSR/CSR avec Orval et MSW",
  "scripts": {
    "api:generate": "orval --config ./orval.config.ts",
    "api:lint": "redocly lint specs/*.yaml",
    "start": "npm run start:mock",
    "prestart:mock": "npm run api:generate",
    "start:mock": "cross-env API_MODE=mock CMS_MODE=mock MSW_SERVER=true MSW_BROWSER=true ng serve",
    "prestart:hybrid": "npm run api:generate",
    "start:hybrid": "cross-env API_MODE=mock CMS_MODE=real CMS_URL=http://localhost:1337 MSW_SERVER=true MSW_BROWSER=true ng serve",
    "prestart:real": "npm run api:generate",
    "start:real": "cross-env API_MODE=real CMS_MODE=real MSW_SERVER=false MSW_BROWSER=false ng serve",
    "prebuild": "npm run api:generate",
    "build": "ng build",
    "prebuild:release": "npm run api:generate",
    "build:release": "ng build --configuration release",
    "serve:ssr": "node dist/selfcare-web/server/server.mjs",
    "pretest": "npm run api:generate",
    "test": "ng test",
    "test:mocks": "vitest run --config vitest.mocks.config.ts",
    "cms:up": "docker compose up -d strapi",
    "cms:down": "docker compose down",
    "msw:init": "msw init apps/selfcare-web/public --save",
    "postinstall": "msw init apps/selfcare-web/public"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/platform-server": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/ssr": "^21.0.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@faker-js/faker": "^10.0.0",
    "@redocly/cli": "^2.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "cross-env": "^10.0.0",
    "jsdom": "^27.0.0",
    "msw": "~2.12.14",
    "orval": "^8.9.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  },
  "msw": {
    "workerDirectory": [
      "apps/selfcare-web/public"
    ]
  }
}
