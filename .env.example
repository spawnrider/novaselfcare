# --- Mode d'exécution -------------------------------------------------------
# MOCK_FULL : API_MODE=mock  CMS_MODE=mock
# HYBRID    : API_MODE=mock  CMS_MODE=real   (Strapi via docker compose)
# REAL      : API_MODE=real  CMS_MODE=real   MSW_SERVER=false MSW_BROWSER=false
API_MODE=mock
CMS_MODE=real
MSW_SERVER=true
MSW_BROWSER=true

# Scénario par défaut (surchargé par ?scenario=, cookie ou localStorage)
MSW_SCENARIO=nominal

# --- URLs -------------------------------------------------------------------
# URL vue par le serveur SSR / URL vue par le navigateur (peuvent différer en conteneur)
CMS_URL=http://localhost:1337
CMS_PUBLIC_URL=http://localhost:1337
BUSINESS_API_URL=
BUSINESS_API_PUBLIC_URL=
